#!/usr/bin/env bash
# Publish pipeline (download upstream wheels, collect local aarch64 builds,
# rename to pyrealsense2-extended, twine check, twine upload).
#
# Reproducible entry point. Run the exact same thing locally or in CI:
#
#   nix run .#publish          # uses the flake-pinned python + twine
#
# Requirements:
#   - wheelhouse/ must already contain the aarch64 manylinux wheels
#     (build them with ./run/build — Docker/manylinux, not nix).
#   - PyPI credentials via env: TWINE_USERNAME=__token__ TWINE_PASSWORD=pypi-...
#     (or ~/.pypirc). Set PUBLISH_SKIP_UPLOAD=1 to stop before uploading.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "=== Step 1: Download upstream wheels + collect local aarch64 ==="
python3 download_wheels.py

echo ""
echo "=== Step 2: Rename all wheels to pyrealsense2-extended ==="
rm -rf renamed_wheels
python3 rename_wheel.py

WHEELS=( renamed_wheels/*.whl )
if [[ ${#WHEELS[@]} -eq 0 || ! -f "${WHEELS[0]}" ]]; then
    echo "ERROR: No wheels in renamed_wheels/. Did rename step fail?" >&2
    exit 1
fi

echo ""
echo "=== Step 3: Validate with twine check ==="
python3 -m twine check "${WHEELS[@]}"

if [[ "${PUBLISH_SKIP_UPLOAD:-}" == "1" ]]; then
    echo ""
    echo "PUBLISH_SKIP_UPLOAD=1 set — stopping before upload."
    echo "Wheels ready in renamed_wheels/:"
    printf '  %s\n' "${WHEELS[@]}"
    exit 0
fi

echo ""
echo "=== Step 4: Upload to PyPI ==="
python3 -m twine upload --non-interactive --verbose --skip-existing "${WHEELS[@]}"

echo ""
echo "Done!"
